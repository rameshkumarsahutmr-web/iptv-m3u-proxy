{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/playlist.m3u",
      "dest": "/api/index.js"
    },
    {
      "src": "/playlist.m3u8",
      "dest": "/api/index.js"
    },
    {
      "src": "/get.php",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
